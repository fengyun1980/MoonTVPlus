<?xml version="1.0" encoding="utf-8"?>
<!--
    三层结构：
    Layer 1 (底层): WebView —— 加载 Next.js 页面（封面/列表/UI）
    Layer 2 (中层): fullscreen_container —— WebChromeClient customView 全屏容器
    Layer 3 (顶层): exo_player_view —— ExoPlayer 原生播放器覆盖层（PiP/悬浮窗可靠来源）
    
    ExoPlayer PlayerView 的好处：
    - 原生 Surface 渲染，Activity PiP 不黑屏
    - 可以直接加到 WindowManager 做悬浮窗
    - 跟 MediaSession 天然联动（超级岛）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="false">

    <!-- Layer 1: WebView —— 加载所有 UI -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 2: WebChromeClient 全屏容器 -->
    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Layer 3: ExoPlayer PlayerView 覆盖层 —— 原生视频渲染 -->
    <!-- 重要：不要设自定义 controller_layout_id，否则缺少 exo_progress/exo_controller 等标准 ID 会导致 PlayerView 内部 NPE 崩溃 -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/exo_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:keepScreenOn="true"
        app:resize_mode="fit"
        app:use_controller="true"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</FrameLayout>
